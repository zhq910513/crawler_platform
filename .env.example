APP_NAME=crawler_platform
APP_ENV=production
APP_VERSION=1.0.0
PLATFORM_IMAGE_TAG=latest
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
WEB_PORT=8080

MYSQL_ROOT_PASSWORD=ReplaceWithStrongRootPassword
MYSQL_DATABASE=crawler_platform
MYSQL_USER=crawler_platform
MYSQL_PASSWORD=ReplaceWithStrongDatabasePassword
DATABASE_URL=mysql+pymysql://crawler_platform:ReplaceWithStrongDatabasePassword@mysql:3306/crawler_platform?charset=utf8mb4

REDIS_PASSWORD=ReplaceWithStrongRedisPassword
REDIS_URL=redis://:ReplaceWithStrongRedisPassword@redis:6379/0

JWT_SECRET=ReplaceWithAtLeast32CharactersJwtSecret
JWT_EXPIRE_MINUTES=720
SECRET_ENCRYPTION_KEY=ReplaceWithLongEncryptionMasterKey

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword
ADMIN_NICKNAME=超级管理员

CICD_TOKEN=ReplaceWithStrongCicdToken
AGENT_BOOTSTRAP_TOKEN=ReplaceWithStrongAgentBootstrapToken
AGENT_LEASE_SECONDS=90
SCHEDULER_POLL_SECONDS=5
SCHEDULER_LOCK_SECONDS=60

TASK_LOG_ROOT=/data/task-logs
TASK_LOG_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=14
CORS_ORIGINS=*
