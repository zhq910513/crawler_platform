APP_NAME=crawler_platform
APP_ENV=production
APP_VERSION=1.0.92
PLATFORM_IMAGE_TAG=1.0.92
APP_GIT_COMMIT=unknown
APP_BUILD_TIME=unknown
AGENT_AGENT_VERSION=1.1.2
CRAWLER_AGENT_IMAGE=crawler_platform_agent:1.1.2
CRAWLER_AGENT_IMAGE_DIGEST=
# 内置 Agent 镜像仓库自动准备脚本会根据控制端公网地址推导；如需固定可显式配置。
CRAWLER_AGENT_REGISTRY_PUBLIC_HOST=
CRAWLER_AGENT_REGISTRY_PORT=5000
CRAWLER_AGENT_REGISTRY_AUTH_ENABLED=0
CRAWLER_AGENT_REGISTRY_TLS_ENABLED=0
AUTO_PREPARE_AGENT_IMAGE=1

# 平台自检一键动作开关。默认关闭，避免 API 容器未经授权访问宿主机 Docker。
# 启用前必须确认已按部署文档挂载项目目录和 Docker 权限；未启用时页面会给出手动兜底命令。
CRAWLER_PLATFORM_ACTIONS_ENABLED=0
CRAWLER_PLATFORM_ACTION_ROOT=/data/projects/crawler_platform
CRAWLER_PLATFORM_ACTION_TIMEOUT_SECONDS=1800
AGENT_GIT_COMMIT=unknown
AGENT_BUILD_TIME=unknown
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
WEB_PORT=80
CRAWLER_CONTROL_PUBLIC_BASE_URL=

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://mirror.ccs.tencentyun.com
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
APK_MIRROR=mirrors.aliyun.com


MYSQL_ROOT_PASSWORD=ReplaceWithStrongRootPassword
MYSQL_DATABASE=crawler_platform
MYSQL_USER=crawler_platform
MYSQL_PASSWORD=ReplaceWithStrongDatabasePassword
DATABASE_URL=mysql+pymysql://crawler_platform:ReplaceWithStrongDatabasePassword@mysql:3306/crawler_platform?charset=utf8mb4

REDIS_PASSWORD=ReplaceWithStrongRedisPassword
REDIS_URL=redis://:ReplaceWithStrongRedisPassword@redis:6379/0

JWT_SECRET=ReplaceWithAtLeast32CharactersJwtSecret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
SESSION_ACTIVE_MINUTES=10
FORCE_LOGIN_TOKEN_MINUTES=2
SECRET_ENCRYPTION_KEY=ReplaceWithLongEncryptionMasterKey

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword
ADMIN_NICKNAME=超级管理员

AGENT_LEASE_SECONDS=90
AGENT_STALE_SECONDS=60
AGENT_OFFLINE_SECONDS=120
SCHEDULER_POLL_SECONDS=5
SCHEDULER_LOCK_SECONDS=60

TASK_LOG_ROOT=/data/task-logs
TASK_LOG_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=14
SSE_POLL_SECONDS=0.5
SSE_KEEPALIVE_SECONDS=15
CORS_ORIGINS=
ENABLE_API_DOCS=false

# 爬虫项目平台构建中心（v1.0.92 最小闭环；默认关闭，启用前需确认构建宿主机 git/docker/registry 权限）
CRAWLER_PROJECT_BUILD_ENABLED=0
CRAWLER_PROJECT_BUILD_ROOT=/data/project-builds
CRAWLER_PROJECT_BUILD_TIMEOUT_SECONDS=1800
CRAWLER_PROJECT_IMAGE_REPOSITORY_PREFIX=
CRAWLER_PROJECT_BUILD_PLATFORM=linux/amd64
CRAWLER_PROJECT_BUILD_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
