[Unit]
Description=crawler_platform Agent
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crawler-agent
EnvironmentFile=/opt/crawler-agent/.env
ExecStart=/opt/crawler-agent/venv/bin/python -m crawler_agent.main
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
