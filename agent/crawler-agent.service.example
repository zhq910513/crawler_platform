[Unit]
Description=crawler_platform Agent V2
Documentation=file:/opt/crawler-agent/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0027
WorkingDirectory=/opt/crawler-agent
EnvironmentFile=/opt/crawler-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/crawler-agent/venv/bin/python -m crawler_agent.main
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=60
LimitNOFILE=65535

# Agent must access Docker Socket and chown each TaskRun directory for the
# non-root crawler container. The remaining system surface is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/crawler-agent /var/run/docker.sock

[Install]
WantedBy=multi-user.target
