# crawler_platform 管理端地址（Agent 主动发起 HTTPS 请求）
PLATFORM_URL=https://crawler-platform.example.com
PLATFORM_VERIFY_TLS=true
# 仅内网临时测试 HTTP 时显式设为 true；生产建议始终使用 HTTPS。
AGENT_ALLOW_INSECURE_HTTP=false
AGENT_BOOTSTRAP_TOKEN=ReplaceWithSameValueAsPlatform

AGENT_CODE=crawler-prod-01
SERVER_CODE=crawler-prod-01
SERVER_NAME=爬虫生产服务器01
AGENT_VERSION=2.0.0
# 留空则每次服务启动生成新 instance_id；通常无需手工配置。
AGENT_INSTANCE_ID=

AGENT_MAX_SLOTS=4
AGENT_CAPABILITIES=["api","browser"]
AGENT_LABELS={"region":"cn-east","network":"china"}
AGENT_HEARTBEAT_SECONDS=15
AGENT_CLAIM_SECONDS=3
AGENT_RUN_HEARTBEAT_SECONDS=10
AGENT_REQUEST_TIMEOUT_SECONDS=15

AGENT_RUN_ROOT=/var/lib/crawler-agent/runs
AGENT_LOG_UPLOAD_BATCH_SIZE=200
AGENT_EVENT_UPLOAD_BATCH_SIZE=100
AGENT_RECOVERY_SCAN_SECONDS=10
AGENT_COMPLETED_RETENTION_HOURS=72

CRAWLER_CONTAINER_UID=10001
CRAWLER_CONTAINER_GID=10001
AGENT_CONTAINER_NETWORK=bridge

# 私有镜像仓库凭据，可留空。
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
