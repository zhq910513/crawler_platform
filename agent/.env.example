PLATFORM_URL=http://management-server:8080
PLATFORM_VERIFY_TLS=true
AGENT_BOOTSTRAP_TOKEN=change-this-agent-bootstrap-token
SERVER_CODE=crawler-prod-01
SERVER_NAME=爬虫生产服务器01
SERVER_IP=10.0.0.21
SERVER_ENVIRONMENT=production
MAX_CONTAINER_SLOTS=4
AGENT_POLL_SECONDS=3
AGENT_HEARTBEAT_SECONDS=15
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_STATE_FILE=/var/lib/crawler-agent/state.json
AGENT_DISK_PATH=/

# 私有镜像仓库可选配置
DOCKER_REGISTRY=registry.example.com
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
