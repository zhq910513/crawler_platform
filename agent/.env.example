AGENT_CONTROL_PLANE_URL=http://control-plane.example.com
AGENT_AGENT_TOKEN=replace-with-token-from-platform
AGENT_AGENT_CODE=agent-h-001
AGENT_SERVER_CODE=server-h-001
AGENT_MAX_SLOTS=2
AGENT_VERIFY_TLS=false

AGENT_CAPABILITIES_JSON={"browser":false,"proxy":false}
# 项目环境共享 + 独立任务容器运行目录
AGENT_PROJECT_DATA_ROOT=/data/crawler-platform/projects
AGENT_DEFAULT_SHM_SIZE_MB=64
AGENT_PIDS_LIMIT=1024
AGENT_LOG_MAX_FILE=3
AGENT_ENABLE_SHARED_PROJECT_CACHE=true
# 可选：任务容器加入指定 Docker 网络
AGENT_DOCKER_NETWORK=
# 可选：任务容器非 root 运行用户，例如 1000:1000
AGENT_CONTAINER_USER=
AGENT_READ_ONLY_ROOTFS=false
